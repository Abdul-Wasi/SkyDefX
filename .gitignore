# Java-specific ignore rules
*.class                # Compiled Java class files
*.jar                  # Jar files
*.war                  # War files
*.ear                  # Ear files
*.nar                  # Nar files
*.zip
*.tar.gz
hs_err_pid* # JVM crash logs
.classpath             # Eclipse project files
.project               # Eclipse project files
.settings/             # Eclipse project settings
.idea/                 # IntelliJ IDEA project files
*.iml                  # IntelliJ IDEA module files
*.ipr                  # IntelliJ IDEA project files
*.iws                  # IntelliJ IDEA workspace files
out/                   # IntelliJ IDEA output directory
target/                # Maven/Gradle build directory
bin/                   # Common output directory
**/*.bak               # Backup files
**/*~                  # Emacs backup files
**/.DS_Store           # macOS specific files
Thumbs.db              # Windows thumbnail cache
.vs/                   # Visual Studio Code internal files
*.log
*.txt
# Resource files (if you don't want them tracked)
# /res/sounds/*.wav   # Uncomment if you want to exclude actual audio files